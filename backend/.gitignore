# ===================
# Backend .gitignore (Python)
# ===================

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Environment variables
.env
.env.*

# IDE
.vscode/
.idea/

# Testing / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Uploaded binary files — never commit these
*.bin
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.dat

# ChromaDB databases
**/chroma_db/
chroma_db/
knowledge_base/chroma_db/

# Live search results
backend/knowledge_base/walkthroughs/live_*
knowledge_base/walkthroughs/live_*

# CAG hint cache database
cache/hints.db

# Analytics and feedback logs
logs/*.log
