# ===================
# Backend .gitignore (Python)
# ===================

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Environment variables
.env
.env.*

# IDE
.vscode/
.idea/

# Testing / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Uploaded binary files — never commit these
*.bin
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.dat

# Block the ChromaDB binary database (large, machine-specific)
backend/knowledge_base/chroma_db/
**/chroma_db/
chroma_db/

# Block log files
backend/logs/*.log

# CAG hint cache database
cache/hints.db
