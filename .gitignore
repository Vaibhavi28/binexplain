# ===================
# Root-level .gitignore for BinExplain monorepo
# ===================

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Uploaded binary files — never commit these
*.bin
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.dat

# Added for BinExplain monorepo clean-up
frontend/*.elf
frontend/*.exe
frontend/*.bin
backend/logs/*.log
backend/cache/*.db-shm
backend/cache/*.db-wal
backend/cache/*.db-journal

# Scraped walkthrough files - runtime-generated, never commit
backend/knowledge_base/walkthroughs/
backend/knowledge_base/scraper_checkpoint.json
.env

# Category feedback accuracy logs
backend/logs/category_accuracy.log
logs/category_accuracy.log

# Filter scripts and temporary logs
clean_ui_mojibake.py
fix_encoding.py
replace_emojis.py
strip_emojis.py
tb.txt
tb_chaos.txt
scratch_*.py